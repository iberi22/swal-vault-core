{
  "name": "@swal/vault",
  "version": "0.2.0",
  "description": "SWAL Vault Core: browser-safe end-to-end encryption for local-first apps (AES-256-GCM AEAD, Shamir 2-of-3 key shares, Ed25519-signed sealed packs, optional R2 cloud share). WebCrypto only.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./web": {
      "types": "./dist/web/vault-client.d.ts",
      "import": "./dist/web/vault-client.js"
    },
    "./web.js": {
      "types": "./dist/web/vault-client.d.ts",
      "import": "./dist/web/vault-client.js"
    },
    "./sealedPack": {
      "types": "./dist/sealedPack.d.ts",
      "import": "./dist/sealedPack.js"
    },
    "./sealedPack.js": {
      "types": "./dist/sealedPack.d.ts",
      "import": "./dist/sealedPack.js"
    },
    "./r2Client": {
      "types": "./dist/r2Client.d.ts",
      "import": "./dist/r2Client.js"
    },
    "./r2Client.js": {
      "types": "./dist/r2Client.d.ts",
      "import": "./dist/r2Client.js"
    },
    "./envelope": {
      "types": "./dist/envelope/index.d.ts",
      "import": "./dist/envelope/index.js"
    },
    "./cloudShare": {
      "types": "./dist/cloudShare.d.ts",
      "import": "./dist/cloudShare.js"
    },
    "./cloudShare.js": {
      "types": "./dist/cloudShare.d.ts",
      "import": "./dist/cloudShare.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "fake-indexeddb": "6.2.5",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iberi22/swal-vault-core.git"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "e2ee",
    "webcrypto",
    "aes-gcm",
    "shamir",
    "local-first",
    "encryption"
  ]
}
